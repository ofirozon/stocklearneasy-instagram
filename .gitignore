__pycache__/

# Reels are uploaded to the "media" GitHub release and fetched from there by
# Instagram, never committed. At ~6MB a day a year of video in git history
# would be several gigabytes, and git cannot forget it afterwards. The
# committed reel.json carries the URL the publisher actually uses.
*.mp4

# Cover stills are copied into the slot that needs them; the ones in
# animation/out are build scratch.
animation/out/*.jpg
animation/out/*.png
